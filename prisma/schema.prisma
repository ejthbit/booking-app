generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model doctorServices {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamp(6)
  month      String   @db.VarChar(255)
  days       Json?    @db.Json
  workplace  Int

  @@index([month, workplace])
}

model users {
  id                Int      @id @default(autoincrement())
  created_at        DateTime @default(now()) @db.Timestamp(6)
  email             String   @unique @db.VarChar(255)
  password          String
  name              String?  @db.VarChar(255)
  default_workplace Int?
  role              String   @default("user") @db.VarChar(20)
}

model workplaces {
  id           Int      @id @default(autoincrement())
  created_at   DateTime @default(now()) @db.Timestamp(6)
  name         String   @db.VarChar(255)
  full_name    String?  @db.VarChar(255)
  address      String?
  workplace_id Int      @unique
  contact      Json?    @db.Json
}

model doctors {
  id                      Int      @id @default(autoincrement())
  created_at              DateTime @default(now()) @db.Timestamp(6)
  doctor_id               Int
  name                    String   @db.VarChar(255)
  workplace_id            String[]
  preferred_service_start String?  @db.VarChar(5)
  categories              String[]
}

model sonography {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamp(6)
  date       String   @db.VarChar(255)
  from       String   @db.VarChar(255)
  to         String   @db.VarChar(255)
}

model appointments {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamp(6)
  name       String   @db.VarChar(255)
  birthdate  String   @db.VarChar(255)
  contact    Json?    @db.Json
  start      DateTime @db.Timestamptz(6)
  end        DateTime @db.Timestamptz(6)
  workplace  Int
  category   Int
  completed  Boolean?
  note       String?

  @@index([workplace, start])
}

model configuration {
  id                Int      @id @default(autoincrement())
  created_at        DateTime @default(now()) @db.Timestamp(6)
  workplace_id      Int
  lunch_break_times Json?    @db.Json
}

model categories {
  id          Int      @id @default(autoincrement())
  created_at  DateTime @default(now()) @db.Timestamp(6)
  name        String   @db.VarChar(255)
  category_id Int

  @@index([category_id])
}

model announcements {
  id          Int      @id @default(autoincrement())
  created_at  DateTime @default(now()) @db.Timestamp(6)
  name        String   @db.VarChar(255)
  description String?
  author      String?  @db.VarChar(255)
  enabled     Boolean  @default(true)
}

model vacations {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamp(6)
  start      DateTime @db.Timestamptz(6)
  end        DateTime @db.Timestamptz(6)
  workplace  Int
  note       String?
  created_by String   @db.VarChar(255)

  @@index([workplace, start, end])
}
